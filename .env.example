# Lead notifications → Telegram (used by /api/lead serverless function).
# Set these in Vercel → Project → Settings → Environment Variables for prod,
# and copy this file to `.env` for local `npm run dev` or `vercel dev`.
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Live voice demo (hero widget) — public landing-demo API.
# Set the production URL locally to reuse the live site's public catalog.
# An ignored .env.local may override an older localhost value from .env.
# VITE_API_BASE_URL=https://api.syncallai.com

# Public Google OAuth Web client ID used if the API config endpoint is not yet
# available during a rolling deployment.
# VITE_GOOGLE_OAUTH_CLIENT_ID=800135338574-odbidn4en6m303c83l3gn3evg4a782cp.apps.googleusercontent.com

# Cloudflare Turnstile public site key for the voice demo. Unset = widget
# skipped, which only works against a backend with Turnstile validation
# disabled (local dev). Never put the Turnstile SECRET here.
# VITE_TURNSTILE_SITE_KEY=

# Telegram Web Login public Client ID from BotFather. When set, the voice demo
# asks Telegram to share a verified phone number before creating a session.
# The Bot API token and Web Login Client Secret must never be exposed here.
# VITE_TELEGRAM_CLIENT_ID=8851428493

# Optional: live STT / TTS endpoints. Unset = built-in mocks.
# VITE_STT_API_URL=
# VITE_TTS_API_URL=

# Optional: override the lead endpoint (defaults to /api/lead).
# VITE_LEAD_API_URL=

# Optional server-side CRM/lead receiver used by /api/lead. Configure only after
# confirming its request schema; see docs/retell-redesign.md. Never use VITE_ for
# this service token. Telegram notifications can run alongside lead storage.
# LEADS_API_URL=https://your-backend.example/leads
# LEADS_API_TOKEN=

# By default all scenario cards reuse Poytaxt from the production public catalog
# (or its single legacy agent). No copied slug is required. An empty catalog
# shows recordings. Set a shared exact slug to pin that agent if needed.
# VITE_DEMO_SHARED_SLUG=
# Optional future dedicated agents override the shared selection per scenario.
# VITE_DEMO_SUPPORT_SLUG=
# VITE_DEMO_COLLECTION_SLUG=
# VITE_DEMO_SALES_SLUG=
