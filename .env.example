# Lead notifications → Telegram (used by /api/lead serverless function).
# Set these in Vercel → Project → Settings → Environment Variables for prod,
# and copy this file to `.env` for local `vercel dev`.
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Live voice demo (hero widget) — public landing-demo API.
# Unset in dev = http://localhost:8000; unset in prod build = https://api.syncallai.com.
# VITE_API_BASE_URL=https://api.syncallai.com

# Cloudflare Turnstile public site key for the voice demo. Unset = widget
# skipped, which only works against a backend with Turnstile validation
# disabled (local dev). Never put the Turnstile SECRET here.
# VITE_TURNSTILE_SITE_KEY=

# Telegram Web Login public Client ID from BotFather. When set, the voice demo
# asks Telegram to share a verified phone number before creating a session.
# The Bot API token and Web Login Client Secret must never be exposed here.
# VITE_TELEGRAM_CLIENT_ID=8851428493

# Optional: live STT / TTS endpoints. Unset = built-in mocks.
# VITE_STT_API_URL=
# VITE_TTS_API_URL=

# Optional: override the lead endpoint (defaults to /api/lead).
# VITE_LEAD_API_URL=
